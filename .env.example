# 复制为项目根目录的 .env，填入自己的密钥；.env 自动读取且被 Git 忽略。
# 环境变量优先于 .env；不要把密钥发到聊天或提交到 Git。
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 以下是本项目的调用限制，不是模型的最大能力。
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=1

# 可选的向量化配置：三项都填才会启用「BM25 + 稠密」混合检索。
# DeepSeek 没有 embedding 接口，所以留空就是常态——留空会自动降级回纯 BM25，
# 这不是错误，也不会报错。任何兼容 OpenAI /embeddings 协议的服务都可以填。
# 例（智谱）：EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4  EMBED_MODEL=embedding-3
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_TIMEOUT_SECONDS=60
